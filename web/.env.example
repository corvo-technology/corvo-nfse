# Browser calls the same-origin proxy. The global /v1 prefix appears once.
NEXT_PUBLIC_API_URL=/api/proxy/v1
# Server-only upstream origin, without /v1.
API_BASE_URL=http://localhost:3000
# Exact browser origin. Required in production; HTTPS in production.
APP_ORIGIN=http://localhost:4000
SITE_ACCESS_MODE=open
# Optional analytics (consent required; login/dashboard excluded).
# NEXT_PUBLIC_GA_ID=

# PostHog browser analytics and source-map upload
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Build-time only (source maps). Never expose as NEXT_PUBLIC_*; leave empty to skip upload.
POSTHOG_API_KEY=your_posthog_personal_api_key_here
POSTHOG_PROJECT_ID=your_posthog_project_id_here
