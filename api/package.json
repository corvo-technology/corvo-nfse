{
  "name": "corvo-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24 <26",
    "yarn": ">=1.22"
  },
  "scripts": {
    "build": "nest build && tsc-alias -p tsconfig.build.json && node scripts/verify-build-artifacts.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "ulimit -n 65536 && nest start --watch --path tsconfig.dev.json --entryFile main.dev",
    "start:api:dev": "rm -rf dist && ulimit -n 65536 && nest start --watch --path tsconfig.dev.json --entryFile main",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:worker": "nest start --entryFile main.worker",
    "start:worker:dev": "ulimit -n 65536 && nest start --watch --path tsconfig.dev.json --entryFile main.worker",
    "start:worker:prod": "node dist/main.worker",
    "sentry:canary:prod": "node dist/sentry-canary.js",
    "sentry:release:prepare": "node scripts/sentry-release.mjs prepare",
    "sentry:release:deploy": "node scripts/sentry-release.mjs deploy",
    "migration:run:prod": "node node_modules/typeorm/cli.js migration:run -d dist/infra/database/data-source.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.json",
    "storage:bucket": "bash scripts/create-bucket.sh",
    "graphify": "graphify update .",
    "test": "jest",
    "test:api-key": "node scripts/test-api-key.mjs",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:fiscal:integration": "jest --config ./test/jest-fiscal.json --runInBand",
    "typeorm": "typeorm-ts-node-commonjs -d src/infra/database/data-source.ts",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "migration:generate": "yarn typeorm migration:generate",
    "migration:run": "yarn typeorm migration:run",
    "migration:revert": "yarn typeorm migration:revert",
    "migration:show": "yarn typeorm migration:show",
    "postinstall": "patch-package",
    "stripe:provision": "ts-node -r tsconfig-paths/register scripts/provision-stripe.ts"
  },
  "lint-staged": {
    "{src,test}/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.800.0",
    "@aws-sdk/s3-request-presigner": "^3.800.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.1",
    "@opentelemetry/auto-instrumentations-node": "^0.81.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@sentry/nestjs": "^10.69.0",
    "argon2": "^0.44.0",
    "bullmq": "^5.78.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "decimal.js": "^10.6.0",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.0",
    "jose": "^6.2.3",
    "libphonenumber-js": "1.13.5",
    "luxon": "~3.7.0",
    "nanoid": "3",
    "nestjs-pino": "^4.6.1",
    "node-forge": "1.4.0",
    "open-nfse": "^0.11.0",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.32.1",
    "rxjs": "^7.8.1",
    "stripe": "^23.0.0",
    "typeorm": "^0.3.31",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@sentry/cli": "^3.6.2",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.0.0",
    "codewright": "^0.21.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "jscpd": "^4.0.5",
    "lint-staged": "^16.1.2",
    "patch-package": "^8.0.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.17",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "resolutions": {
    "@nestjs/swagger/js-yaml": "5.2.2",
    "typeorm/**/brace-expansion": "1.1.18"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^open-nfse$": "<rootDir>/../test/__mocks__/open-nfse.ts",
      "^open-nfse/testing$": "<rootDir>/../test/__mocks__/open-nfse-testing.ts"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(@nestjs/bullmq|@nestjs/bull-shared|jose)/)"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
