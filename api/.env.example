# App
APP_NAME=corvo
APP_VERSION=1.0.0
NODE_ENV=development
PORT=3000
WORKER_PORT=3002
API_PREFIX=v1
CORS_ORIGINS=http://localhost:4000,http://localhost:5173
# Public HTTPS API origin in production.
PUBLIC_API_URL=https://api.example.com

# Database
DATABASE_URL=postgresql://corvo_backend_runtime:changeme@localhost:5434/corvo_dev
# Runtime must use NOSUPERUSER NOBYPASSRLS. Migrations use the schema owner.
MIGRATION_DATABASE_URL=postgresql://corvo:changeme@localhost:5434/corvo_dev
E2E_DATABASE_URL=postgresql://corvo:changeme@localhost:5434/corvo_test
REDIS_URL=redis://localhost:6381
DB_SCHEMA=corvo
# PostgreSQL over TLS (managed databases). The server certificate is verified by default;
# set DB_SSL_CA to the provider/private CA (PEM, \n allowed) if it is not publicly trusted.
# DB_SSL=true
# DB_SSL_CA=
# DB_SSL_REJECT_UNAUTHORIZED=true
DB_APPLICATION_NAME=corvo-api
DB_CHECKPOINT_APPLICATION_NAME=corvo-checkpoint
DB_POOL_MIN=2
DB_POOL_MAX=30
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=3000
DB_POOL_MAX_LIFETIME_SECONDS=1800
REDIS_KEY_PREFIX=corvo

# Auth
AUTH_JWT_SECRET=<generate>
AUTH_CSRF_SIGNING_SECRET=<generate>
SECRETS_ENCRYPTION_KEY=<generate>

OTP_HMAC_SECRET=<generate_32_character_secret>

# Stripe
STRIPE_SECRET_KEY=<stripe_key>
STRIPE_PLATFORM_WEBHOOK_SECRET=<webhook_secret>
STRIPE_PORTAL_CONFIGURATION_ID=<portal_configuration_id>
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:4000/app/billing/success
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:4000/app/billing/cancel
STRIPE_PUBLISHABLE_KEY=<publishable_key>

# Outbox and scheduling
OUTBOX_RELAY_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE_MS=120000
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_SCHEDULE_MAX_DAYS=15

# RTC calculator (internal Calculadora de Tributos; see deploy/README.md)
RTC_CALCULATOR_URL=http://localhost:18080/api
RTC_CALCULATOR_TIMEOUT_MS=8000
RTC_CALCULATOR_MAX_CONCURRENCY=8
RTC_CIRCUIT_FAILURE_THRESHOLD=5
RTC_CIRCUIT_RESET_MS=30000
FISCAL_DPS_LAYOUT=rtc-v1.01

# Dashboard
DASHBOARD_URL=http://localhost:4000

# Social Auth (Google)
GOOGLE_CLIENT_ID=<client_id>
GOOGLE_CLIENT_SECRET=<client_secret>
GOOGLE_REDIRECT_URL=http://localhost:3000/auth/google/callback

# Social Auth (GitHub)
GITHUB_CLIENT_ID=<client_id>
GITHUB_CLIENT_SECRET=<client_secret>
GITHUB_REDIRECT_URL=http://localhost:3000/auth/github/callback

# Magic Link
MAGIC_LINK_CODE_TTL_MINUTES=10
MAGIC_LINK_MAX_ATTEMPTS_PER_HOUR=5

# Email (MillionSend)
# Required for email delivery and for production boot. Optional for local boot.
RESEND_API_KEY=ms_your_api_key_here
RESEND_BASE_URL=https://api.millionsend.com
EMAIL_FROM=Corvo <noreply@corvo.tech>
# Base URL of the Corvo web app (used in email buttons, e.g. welcome email)
APP_URL=http://localhost:4000/app

# NFS-e (Brazilian Electronic Invoice)
NFSE_MASTER_KEY=<generate_32_byte_hex_or_base64>

# Storage
# Local development uses the S3 storage profile (LocalStack).
STORAGE_PROVIDER=s3
STORAGE_S3_BUCKET=corvo-nfse
STORAGE_S3_ENDPOINT=http://localhost:4566
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY_ID=test
STORAGE_S3_SECRET_ACCESS_KEY=test
STORAGE_S3_FORCE_PATH_STYLE=true
STORAGE_S3_PREFIX=invoices
STORAGE_PUBLIC_BASE_URL=http://localhost:4566

# Observability
OTEL_ENABLED=false
OTEL_SERVICE_NAME=corvo
SENTRY_ENABLED=false
# SENTRY_DSN=https://your-sentry-dsn

# HTTP requests per 60-second window
RATE_LIMIT_AUTHENTICATED=300
RATE_LIMIT_PUBLIC=120
RATE_LIMIT_PRE_AUTH=1200
RATE_LIMIT_STRIPE_WEBHOOK=600
