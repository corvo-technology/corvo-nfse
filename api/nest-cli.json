{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "modules/invoice/infra/fiscal/catalog/*.json",
        "outDir": "dist"
      },
      {
        "include": "modules/invoice/infra/danfse/assets/*",
        "outDir": "dist"
      },
      {
        "include": "infra/external/nfe/sefaz/certs/*",
        "outDir": "dist"
      },
      {
        "include": "infra/external/nfe/sefaz/schemas/**/*.xsd",
        "outDir": "dist"
      }
    ],
    "plugins": [
      {
        "name": "@nestjs/swagger",
        "classValidatorShim": true,
        "introspectComments": true,
        "controllerFileNameSuffix": [".controller.ts"],
        "dtoFileNameSuffix": [".dto.ts"]
      }
    ]
  }
}
