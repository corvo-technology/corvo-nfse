# Local test stack with LocalStack. Production uses a separate env file.
CORVO_ENV_FILE=.env.local
NODE_ENV=development
WEB_PORT=4000
API_PORT=3000
WEB_BIND_ADDRESS=127.0.0.1
API_BIND_ADDRESS=127.0.0.1
APP_ORIGIN=http://localhost:4000
PUBLIC_API_URL=http://localhost:3000
POSTGRES_PASSWORD=<generate>
POSTGRES_RUNTIME_PASSWORD=<generate>
AUTH_JWT_SECRET=<generate>
AUTH_CSRF_SIGNING_SECRET=<generate>
PUBLIC_CUSTOMER_SESSION_HMAC_SECRET=<generate>
SECRETS_ENCRYPTION_KEY=<generate_base64_32_bytes>
NFSE_MASTER_KEY=<generate>
OTP_HMAC_SECRET=<generate>
# Lets the API trust the real visitor IP sent by the web app (rate limits). Same value for api, worker and web.
PROXY_SHARED_SECRET=<generate>
# Set to true ONLY if Cloudflare is the sole way to reach your API/origin; otherwise leave false.
TRUST_CF_CONNECTING_IP=false
STORAGE_PROVIDER=s3
STORAGE_S3_BUCKET=corvo-nfse
STORAGE_S3_ENDPOINT=http://s3.localhost.localstack.cloud:4566
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY_ID=test
STORAGE_S3_SECRET_ACCESS_KEY=test
STORAGE_S3_FORCE_PATH_STYLE=true
# self_hosted turns billing off (no Stripe, credits or plan limits).
DEPLOYMENT_MODE=self_hosted

# Startup placeholders only. Billing requires your own test credentials.
STRIPE_SECRET_KEY=sk_test_local_placeholder
STRIPE_PLATFORM_WEBHOOK_SECRET=whsec_local_placeholder
# Configure email to test login codes and document delivery.
# RESEND_API_KEY=ms_your_api_key
RESEND_BASE_URL=https://api.millionsend.com
EMAIL_FROM=Corvo <noreply@corvo.tech>
TURNSTILE_ALLOWED_HOSTNAMES=localhost
TURNSTILE_DEVELOPMENT_BYPASS_ENABLED=true
SENTRY_ENABLED=false
OTEL_ENABLED=false

# Tax calculator (Calculadora RTC, see deploy/README.md). `node scripts/setup-env.mjs` fills these
# from deploy/rtc-zip-url.txt and docs/fiscal/rtc/ZIP_SHA256.txt; keep them in sync when updating.
RTC_ZIP_URL=<generate>
RTC_ZIP_SHA256=<generate>

# The web build refuses an empty Meta Pixel id (a guard for production images). The local stack has none.
ALLOW_MISSING_PIXEL=1
