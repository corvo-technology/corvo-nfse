# Production. Generate deploy/.env with: node scripts/setup-env.mjs
NODE_ENV=production
# self_hosted turns billing off (no Stripe, credits or plan limits). cloud is the paid service.
DEPLOYMENT_MODE=self_hosted
# Comma-separated, lowercase e-mails that are platform admins (verified e-mail required). Empty = nobody.
PLATFORM_ADMIN_EMAILS=
# Comma-separated e-mails that get an alert when the servers cannot reach the government NFS-e portal.
OPS_ALERT_EMAILS=
WEB_PORT=4000
API_PORT=3000
WEB_BIND_ADDRESS=127.0.0.1
API_BIND_ADDRESS=127.0.0.1
WEB_DOMAIN=corvo.example.com
API_DOMAIN=api.corvo.example.com
APP_ORIGIN=https://corvo.example.com
PUBLIC_API_URL=https://api.corvo.example.com

# Setup generates random passwords and keys. Keep the encryption keys after
# storing certificates or secrets: the encrypted data depends on them.
POSTGRES_PASSWORD=<generate>
POSTGRES_RUNTIME_PASSWORD=<generate>
AUTH_JWT_SECRET=<generate>
AUTH_CSRF_SIGNING_SECRET=<generate>
PUBLIC_CUSTOMER_SESSION_HMAC_SECRET=<generate>
SECRETS_ENCRYPTION_KEY=<generate_base64_32_bytes>
NFSE_MASTER_KEY=<generate>
OTP_HMAC_SECRET=<generate>
# Lets the API trust the real visitor IP sent by the web app (rate limits). Same value for api, worker and web.
PROXY_SHARED_SECRET=<generate>
# Set to true ONLY if Cloudflare is the sole way to reach your API/origin; otherwise leave false.
TRUST_CF_CONNECTING_IP=false

# Existing external S3 bucket (AWS S3, R2, or another compatible service).
STORAGE_PROVIDER=s3
STORAGE_S3_BUCKET=<your_bucket>
STORAGE_S3_ENDPOINT=<https_s3_endpoint>
STORAGE_S3_REGION=<your_region>
STORAGE_S3_ACCESS_KEY_ID=<your_access_key>
STORAGE_S3_SECRET_ACCESS_KEY=<your_secret_key>
STORAGE_S3_FORCE_PATH_STYLE=true

# Email-code login and invoice delivery require real email credentials.
RESEND_API_KEY=<your_email_api_key>
RESEND_BASE_URL=https://api.millionsend.com
EMAIL_FROM=Corvo <noreply@corvo.tech>

# Billing uses your own Stripe account. Only with DEPLOYMENT_MODE=cloud; self_hosted ignores Stripe.
# STRIPE_SECRET_KEY=<your_stripe_secret_key>
# STRIPE_PLATFORM_WEBHOOK_SECRET=<your_stripe_webhook_secret>

# Pix payments through Woovi (optional). Set PAYMENT_ALLOWED_PROVIDERS=stripe,woovi to enable.
# WOOVI_APP_ID=<your_woovi_app_id>
# WOOVI_WEBHOOK_TOKEN=<random_token_16_chars_or_more>

# Optional social sign-in. Set the three values of a provider to enable its button.
# Redirect URL: https://<WEB_DOMAIN>/api/proxy/v1/auth/oauth/<google|github>/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URL=https://corvo.example.com/api/proxy/v1/auth/oauth/google/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URL=https://corvo.example.com/api/proxy/v1/auth/oauth/github/callback
# STRIPE_PORTAL_CONFIGURATION_ID=bpc_...

# Optional, for endpoints protected by Turnstile.
# TURNSTILE_SECRET_KEY=<your_turnstile_secret_key>
TURNSTILE_ALLOWED_HOSTNAMES=corvo.example.com
TURNSTILE_DEVELOPMENT_BYPASS_ENABLED=false
SENTRY_ENABLED=false
OTEL_ENABLED=false

# ---- NF-e / NFC-e ----
# false (default) = only homologation (test); production notes are blocked. true = allow live NF-e/NFC-e.
# Read by the api, the worker AND the web (compose already passes it to all three). Change it, then restart.
NFE_PRODUCTION_ENABLED=false
# Where test NF-e go: sefaz (homologation, default) or fake (in-process simulator, for automated tests only).
# NFE_TEST_PROVIDER=sefaz
# NFE_SEFAZ_TIMEOUT_MS=30000
# Responsible technician written in the NF-e. Set all four or none.
# NFE_RESP_TEC_CNPJ=
# NFE_RESP_TEC_CONTACT=
# NFE_RESP_TEC_EMAIL=
# NFE_RESP_TEC_PHONE=

# ---- Worker tuning (all optional; the defaults are fine) ----
# Daily purge of old finished outbox rows (04:00 Sao Paulo). false = dry run: only counts and logs. Set true after a week of logs.
DATA_RETENTION_ENABLED=false
# Test (homologation) jobs run in their own *-test queues; how many run at once per queue and worker (1 to 10).
# TEST_QUEUE_CONCURRENCY=2
# Brake on calls to each government host: requests per second, burst, and max wait in ms.
# GOV_RATE_LIMIT_PER_SECOND=5
# GOV_RATE_LIMIT_BURST=10
# GOV_RATE_LIMIT_MAX_WAIT_MS=10000
# Outbox / webhook delivery intervals in ms.
# OUTBOX_RELAY_INTERVAL_MS=1000
# WEBHOOK_RETRY_INTERVAL_MS=10000

# Meta Pixel (optional, build-time: web image rebuild required). Empty = Pixel never loads.
# NEXT_PUBLIC_META_PIXEL_ID=
