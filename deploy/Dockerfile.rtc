# syntax=docker/dockerfile:1
# Calculadora de Tributos (RTC), construída do repositório oficial no GitHub (licença MIT):
# https://github.com/ReceitaFederal/calculadora-rtc-regime-regular
# Para atualizar: troque RTC_TAG e RTC_COMMIT (veja docs/fiscal/runbooks/rtc-update.md).
# JAVA_VERSION segue o pom da tag: a 1.7.x usa Java 25; a 1.6.x usa Java 21 (no Java 25 o Lombok não roda sozinho e a compilação falha).
ARG JAVA_VERSION=25

FROM eclipse-temurin:${JAVA_VERSION}-jdk AS build
ARG RTC_REPO=https://github.com/ReceitaFederal/calculadora-rtc-regime-regular
ARG RTC_TAG=1.7.2
ARG RTC_COMMIT=32df7196356e81f2df08e6023fc2b6dbc48036d3
RUN apt-get update \
 && apt-get install -y --no-install-recommends git curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /src
# A tag pode ser movida; o build para se o commit baixado não for o fixado.
RUN git clone --depth 1 --branch "$RTC_TAG" "$RTC_REPO" . \
 && test "$(git rev-parse HEAD)" = "$RTC_COMMIT"
# (O mvnw baixa o Maven pelo curl.) Gera o banco (SQLite) com as migrações do próprio repositório e empacota o jar.
RUN --mount=type=cache,target=/root/.m2 \
    mkdir -p calculadora/db \
 && ./mvnw -B -ntp flyway:migrate -Dflyway.configFiles=./flyway/flyway-pro.conf \
 && ./mvnw -B -ntp clean package -DskipTests

FROM eclipse-temurin:${JAVA_VERSION}-jre
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /src/target/api-regime-geral.jar ./api-regime-geral.jar
COPY --from=build /src/calculadora/db ./calculadora/db
COPY --from=build /src/LICENSE ./LICENSE-calculadora-rtc.txt
RUN useradd -r -u 10001 rtc && chown -R rtc /app
USER rtc
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "api-regime-geral.jar", "--spring.profiles.active=offline"]
