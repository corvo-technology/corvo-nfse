FROM node:24-alpine AS deps

WORKDIR /app

# The deployment platform builds from the repository root. Keep all sources
# explicitly scoped to the API workspace instead of requiring `api/` as its
# configured root directory.
COPY api/package.json api/yarn.lock ./
# The yarn cache lives in a BuildKit cache mount: it speeds up the next builds and stays out of the image layers.
RUN --mount=type=cache,target=/usr/local/share/.cache/yarn,sharing=locked \
  yarn install --frozen-lockfile --ignore-scripts

FROM node:24-alpine AS build

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY api/package.json api/yarn.lock api/nest-cli.json api/tsconfig.json api/tsconfig.build.json ./
COPY api/src ./src
COPY api/scripts/sentry-release.mjs ./scripts/sentry-release.mjs
COPY api/scripts/verify-build-artifacts.mjs ./scripts/verify-build-artifacts.mjs

# Caps the TypeScript compiler heap so parallel builds do not exhaust a small server.
RUN NODE_OPTIONS=--max-old-space-size=2048 yarn run build

ARG SENTRY_RELEASE
ARG SENTRY_ENVIRONMENT=production
ARG SENTRY_ORG=banco-do-brasil
ARG SENTRY_PROJECT=corvo-backend
ARG SENTRY_UPLOAD_SOURCE_MAPS=false
RUN --mount=type=secret,id=sentry_auth_token \
  if [ "$SENTRY_UPLOAD_SOURCE_MAPS" = "true" ]; then \
    test -n "$SENTRY_RELEASE"; \
    SENTRY_AUTH_TOKEN="$(cat /run/secrets/sentry_auth_token)" \
    SENTRY_RELEASE="$SENTRY_RELEASE" \
    SENTRY_ENVIRONMENT="$SENTRY_ENVIRONMENT" \
    SENTRY_ORG="$SENTRY_ORG" \
    SENTRY_PROJECT="$SENTRY_PROJECT" \
    node scripts/sentry-release.mjs prepare; \
  fi

FROM node:24-alpine AS production

ARG SENTRY_RELEASE
ENV NODE_ENV=production
ENV CORVO_RUNTIME_ROLE=api
ENV SENTRY_RELEASE=${SENTRY_RELEASE:-unversioned}
WORKDIR /app

RUN apk add --no-cache curl

RUN addgroup -S nodejs && adduser -S nestjs -G nodejs

COPY api/package.json api/yarn.lock ./
RUN --mount=type=cache,target=/usr/local/share/.cache/yarn,sharing=locked \
  yarn install --frozen-lockfile --production=true --ignore-scripts

COPY --from=build /app/dist ./dist
# Used by the `migrations` service; baked in because a bind mount does not work when the Compose runs from a helper container (Coolify).
COPY api/scripts/deploy-migrate.mjs ./scripts/deploy-migrate.mjs

USER nestjs

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -f "http://127.0.0.1:${PORT:-3000}/v1/health/live" || exit 1

# Apply schema changes before accepting traffic. The migration runner takes a
# PostgreSQL advisory lock, so parallel replica starts safely serialize here.
CMD ["sh", "-c", "exec node dist/main.js"]
